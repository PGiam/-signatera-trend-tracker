---
const { title = 'Signatera Trend Tracker' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    </style>
  </head>
  <body class="min-h-screen bg-slate-50 font-sans text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href="/" class="text-lg font-semibold text-slate-900">Signatera Trend Tracker</a>
        <nav class="flex gap-6 text-sm font-medium text-slate-600">
          <a href="/" class="rounded-md px-2 py-1 transition-colors hover:text-accent-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500">Trends</a>
          <a href="/mentions" class="rounded-md px-2 py-1 transition-colors hover:text-accent-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500">Mentions</a>
          <a href="/ask" class="rounded-md px-2 py-1 transition-colors hover:text-accent-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500">Ask</a>
          <form action="/api/auth/logout" method="post">
            <button type="submit" class="rounded-md px-2 py-1 text-slate-400 transition-colors hover:text-accent-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500">Sign out</button>
          </form>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-6 py-8">
      <slot />
    </main>
  </body>
</html>
