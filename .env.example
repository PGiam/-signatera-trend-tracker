# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Direct Postgres connection using the restricted app_readonly_query role
# (see sql/002_readonly_role_and_views.sql). Used only by the /ask feature.
# Format: postgresql://app_readonly_query:<password>@<host>:5432/postgres
SUPABASE_READONLY_DB_URL=

# Anthropic
ANTHROPIC_API_KEY=

# Reddit (script app, client_credentials grant)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SignateraTrendTracker/1.0 by u/your-username

# YouTube Data API v3
YOUTUBE_API_KEY=

# Shared passcode for viewing the dashboard (not per-user auth — meant to be
# shareable). Whoever has this can log in at /login.
DASHBOARD_PASSCODE=
